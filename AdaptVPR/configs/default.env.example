# Copy this file to .env. Never commit the populated .env file.
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=YOUR_MODEL_NAME

# Route-agent planner/refiner (OpenAI-compatible API).
# The staged experiments/qwen_curriculum workflow uses frozen weather prompts.
ADAPTVPR_PLANNER_API_KEY=local-placeholder
ADAPTVPR_PLANNER_API_BASE=http://127.0.0.1:23002/v1
ADAPTVPR_PLANNER_MODEL=qwen3-vl-4b-instruct-remote
ADAPTVPR_VLM_ROUTER_RETRIES=0

# Online run.py route-agent scheduler. See docs/SCHEDULER.md for its exact rules.
# This is independent of qwen_curriculum/plan.py: its 1000-call default is
# night=500, snow=200, fog=200, rain=100, with no overcast generation.
ADAPTVPR_TARGET_ROUTE_RATIOS=skip:0.25,global:0.25,local:0.25,dual:0.25
ADAPTVPR_WEATHER_THRESHOLD=0.55
ADAPTVPR_OCCLUSION_THRESHOLD=0.58
ADAPTVPR_DEFICIT_WEIGHT=1.0
ADAPTVPR_CAPABILITY_WEIGHT=0.25
ADAPTVPR_MIN_ROUTE_RATIO=0.20
ADAPTVPR_MAX_ROUTE_RATIO=0.30
ADAPTVPR_MIN_ROUTE_DEFICIT_MULTIPLIER=2.0

# Route-agent Global weather quota and scene-risk fallback pool only.
ADAPTVPR_GLOBAL_WEATHER_TARGET_RATIOS=overcast:0.20,fog:0.20,rain:0.20,snow:0.20,night:0.20
ADAPTVPR_GLOBAL_SAFE_WEATHERS=overcast,fog
ADAPTVPR_GLOBAL_MAX_WEATHER_RATIO=0.50

# Runtime dependency paths
VISMATCH_ROOT=../vismatch

# Reflection policy default used by library callers. The public CLI exposes
# --reflection on|off and --max-reflections explicitly. Global always runs once.
ADAPTVPR_MAX_GENERATIONS=4

# Default generator for Global, Local and Dual routes and the Qwen curriculum.
# bash scripts/start_generation_services.sh --wait starts/checks Qwen only.
LIGHTX2V_API_URL=http://127.0.0.1:8001/generate
# Official source checkouts. For a GitHub commit tarball, place its exact commit
# in <source-root>/.adaptvpr-source-revision. The adapters reject other revisions.
# https://github.com/ModelTC/LightX2V
LIGHTX2V_ROOT=/path/to/LightX2V
LIGHTX2V_GIT_COMMIT=522609ecc121b49c20d201b3f00c3dc052821bce
# Exact all-route Qwen stack used by adapters/lightx2v_qwen_image_edit.py
LIGHTX2V_MODEL_ID=Qwen/Qwen-Image-Edit-2511
LIGHTX2V_MODEL_REVISION=6f3ccc0b56e431dc6a0c2b2039706d7d26f22cb9
LIGHTX2V_MODEL_PATH=/path/to/Qwen-Image-Edit-2511
LIGHTX2V_LORA_ID=lightx2v/Qwen-Image-Edit-2511-Lightning
LIGHTX2V_LORA_REVISION=d74eba145674fd7e31b949324e148e21e7118abd
LIGHTX2V_LORA_PATH=/path/to/Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors
LIGHTX2V_INFER_STEPS=4
LIGHTX2V_GUIDANCE_SCALE=1.0
LIGHTX2V_ATTN_MODE=torch_sdpa
LIGHTX2V_CPU_OFFLOAD=1
LIGHTX2V_AUTO_START=0
# Bound startup waits; initialization errors are reported immediately.
LIGHTX2V_READY_TIMEOUT=600
# For limited host RAM, prepare merged BF16 blocks with scripts/prepare_qwen_disk_weights.py.
LIGHTX2V_DISK_OFFLOAD=0
# LIGHTX2V_DISK_MODEL_PATH=/path/to/Qwen-Image-Edit-2511-Lightning-BF16-blocks

# Optional historical IC-Light diagnosis only. Uncomment/configure when adding
# --with-iclight to scripts/start_generation_services.sh. The flag adds a service;
# run.py still uses Qwen on Global, Local and Dual routes.
# ICLIGHT_API_URL=http://127.0.0.1:8002/generate
# ICLIGHT_ROOT=/path/to/IC-Light
# ICLIGHT_GIT_COMMIT=bcf3f29ca85be8a4686215f477b546f5030be8b7
# ICLIGHT_BASE_MODEL_PATH=/path/to/stable-diffusion-v1-5
# ICLIGHT_MODEL_PATH=/path/to/iclight_sd15_fc.safetensors
# ICLIGHT_AUTO_START=0
# Historical custom LoRA format handled by adapters/iclight_lora.py.
# ADAPTVPR_LORA_CHECKPOINT=/path/to/lora_final.safetensors

# Real runs invoked through run.py are strict by default. The --mock CLI flag
# overrides this value only for an explicit offline smoke test.
ADAPTVPR_DISABLE_MOCK=1

# Route-agent DualTraitEvaluator and curriculum CLIP/matcher implementations.
# Curriculum thresholds are frozen in its plan; s_div is descriptive there.
ADAPTVPR_CLIP_MODEL_NAME=openai/clip-vit-base-patch32
ADAPTVPR_CLIP_LOCAL_FILES_ONLY=1
ADAPTVPR_MATCHER_NAME=superpoint-lightglue
