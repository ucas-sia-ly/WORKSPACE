# Independent local Diffusers backend; no endpoint or model download is implicit.
# Set an existing Diffusers-format SD1.x/SD2.x directory (4- or 9-channel UNet).
TARGETED_EDITOR_MODEL_PATH=/your/local/diffusers-model
TARGETED_EDITOR_DEVICE=cuda
TARGETED_EDITOR_DTYPE=float16
TARGETED_EDITOR_STEPS=20
TARGETED_EDITOR_GUIDANCE=7.5
TARGETED_EDITOR_NEGATIVE_PROMPT=
