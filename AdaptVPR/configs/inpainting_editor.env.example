# Explicit local trained SD inpainting checkpoint; never downloaded by this code.
# Require StableDiffusionXLInpaintPipeline or StableDiffusionInpaintPipeline,
# 9-channel UNet, local safetensors. SDXL fp16 uses local variant="fp16".
# Ordinary SD/SDXL base (4 channels), Flux, Qwen and LightX2V are rejected.
INPAINTING_MODEL_PATH=/your/local/stable-diffusion-xl-1.0-inpainting-0.1
INPAINTING_DEVICE=cuda
INPAINTING_DTYPE=float16
INPAINTING_STEPS=20
INPAINTING_GUIDANCE=7.5
INPAINTING_NEGATIVE_PROMPT=
